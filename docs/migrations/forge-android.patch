+[ ${#SELECTED[@]} -gt 0 ] || SELECTED=("${LOCAL_CI_DEFAULT_STAGES[@]}")
+
+# Validate every selected stage before anything slow or stateful runs.
+for s in "${SELECTED[@]}"; do
