+# ── stage file ───────────────────────────────────────────────────────────────
+
+LOCAL_CI_NAME="$(basename -- "$repo_root")"
+LOCAL_CI_DESCRIPTION=""
+LOCAL_CI_OPTIONS_HELP=""
+LOCAL_CI_STAGES=()
+LOCAL_CI_DEFAULT_STAGES=()
+
+# shellcheck source=/dev/null
