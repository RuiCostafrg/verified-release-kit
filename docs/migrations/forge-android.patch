+[ "${#LOCAL_CI_STAGES[@]}" -gt 0 ] || _config_fail "LOCAL_CI_STAGES is empty"
+[ "${#LOCAL_CI_DEFAULT_STAGES[@]}" -gt 0 ] || LOCAL_CI_DEFAULT_STAGES=("${LOCAL_CI_STAGES[@]}")
+
+_is_listed() {
+  local candidate
+  for candidate in "${LOCAL_CI_STAGES[@]}"; do
+    [ "$candidate" != "$1" ] || return 0
+  done
